---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { getDictionary, pagePath, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const p = getDictionary(locale).notFound;
---
<Base locale={locale} path="" title={p.title} noindex>
  <PageHero eyebrow="404" title={p.h1} lede={p.p} />
  <section class="band">
    <div class="wrap"><a class="btn btn-primary" href={pagePath(locale)}>{p.home}</a></div>
  </section>
</Base>
