---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { REPO } from '../config';
import { assetPath, getDictionary, locales, ogLocale, pagePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Locale-neutral path of this page: '' for the home page, 'how-it-works', … */
  path?: string;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { locale, path = '', title, description, noindex = false } = Astro.props;
const t = getDictionary(locale);

const fullTitle = title ? `${title} · ${t.meta.siteName}` : `${t.meta.siteName}: ${t.meta.tagline}`;
const desc = description ?? t.meta.description;
const origin = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(pagePath(locale, path), origin).href;
const ogImage = new URL(assetPath('og.png'), origin).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: t.meta.siteName,
  description: t.meta.description,
  codeRepository: REPO,
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  programmingLanguage: 'Python',
  inLanguage: locale,
  url: canonical,
};
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(pagePath(l, path), origin).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(pagePath('en', path), origin).href} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0a0c0f" />
    <link rel="icon" href={assetPath('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={assetPath('favicon.ico')} sizes="48x48" />
    <link rel="apple-touch-icon" href={assetPath('apple-touch-icon.png')} />
    <link rel="manifest" href={assetPath('site.webmanifest')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.meta.siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale[locale]} />
    {locales.filter((l) => l !== locale).map((l) => (
      <meta property="og:locale:alternate" content={ogLocale[l]} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">{t.a11y.skip}</a>
    <Header locale={locale} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
