---
import { links } from '../config';
import { getDictionary, pagePath, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDictionary(locale);
---
<footer class="foot">
  <div class="wrap row">
    <div class="who">
      <strong>Claimstone</strong>
      <span>{t.footer.licence}</span>
      <p>{t.footer.note}</p>
    </div>
    <nav aria-label={t.a11y.footerNav}>
      <a href={pagePath(locale, 'how-it-works')}>{t.nav.how}</a>
      <a href={pagePath(locale, 'docs')}>{t.nav.docs}</a>
      <a href={pagePath(locale, 'community')}>{t.nav.community}</a>
      <a href={links.repo}>{t.footer.repository}</a>
      <a href={locale === 'it' ? links.readmeIt : links.readme}>{t.footer.readme}</a>
      <a href={links.contributing}>{t.footer.contributing}</a>
      <a href={links.citation}>{t.footer.cite}</a>
    </nav>
  </div>
</footer>

<style>
  .foot { border-top: 1px solid var(--line); padding-block: 36px; color: var(--muted); font-size: 14px; }
  .row { display: flex; gap: 24px 48px; flex-wrap: wrap; justify-content: space-between; }
  .who { display: grid; gap: 4px; max-width: 46ch; }
  .who strong { color: var(--fg); font-size: 16px; }
  .who p { margin-top: 8px; }
  nav { display: flex; gap: 8px 22px; flex-wrap: wrap; align-content: start; }
  a { text-decoration: none; }
  a:hover { color: var(--fg); text-decoration: underline; }
</style>
