---
import { getDictionary, type Locale } from '../i18n';
interface Props { locale: Locale }
const v = getDictionary(Astro.props.locale).verdicts;
---
<section class="band" id="verdicts">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">{v.eyebrow}</p>
      <h2>{v.h2}</h2>
      <p>{v.lede}</p>
    </div>
    <div class="states">
      {v.items.map((i) => (
        <div class="state"><h3>{i.name}</h3><p>{i.p}</p></div>
      ))}
    </div>
    <p class="fine">{v.fine}</p>
  </div>
</section>

<style>
  .states { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; }
  .state { background: var(--surface); border: 1px solid var(--line); border-top: 3px solid var(--accent); border-radius: 10px; padding: 16px; display: grid; gap: 8px; align-content: start; }
  h3 { font-family: var(--mono); font-size: 12px; letter-spacing: 0.02em; font-weight: 500; overflow-wrap: anywhere; }
  .state p { font-size: 14px; color: var(--muted); }
  .fine { margin-top: 20px; color: var(--muted); font-size: 14px; max-width: 70ch; }
  @media (max-width: 960px) { .states { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .states { grid-template-columns: minmax(0, 1fr); } }
</style>
