---
import { getDictionary, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = getDictionary(locale).home.card;
---
<div class="cards" role="group" aria-label={c.label}>
  <div class="card">
    <header><span>{c.chunk}</span><span class="tag">{c.accepted}</span></header>
    <div class="src" set:html={c.source} />
    <div class="claim">{c.claimOk}</div>
    <ul class="checks">{c.checksOk.map((x) => <li>{x}</li>)}</ul>
  </div>
  <div class="card rejected">
    <header><span>{c.chunk}</span><span class="tag">{c.rejected}</span></header>
    <div class="claim first">{c.claimBad}</div>
    <ul class="checks">{c.checksBad.map((x) => <li>{x}</li>)}</ul>
  </div>
  <p class="note">{c.note}</p>
</div>

<style>
  .cards { display: grid; gap: 14px; min-width: 0; }
  .card { background: var(--hero-card); border: 1px solid var(--hero-line); border-radius: 12px; padding: 18px; font-family: var(--mono); font-size: 13px; line-height: 1.65; min-width: 0; color: var(--hero-fg); }
  header { display: flex; justify-content: space-between; gap: 12px; color: var(--hero-muted); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 12px; flex-wrap: wrap; }
  .src { color: #b9c1c9; }
  .src :global(mark) { background: var(--accent-soft); color: var(--hero-fg); box-shadow: inset 0 -2px 0 var(--accent); padding: 0 2px; }
  .claim { margin-top: 14px; padding-top: 14px; border-top: 1px dashed var(--hero-line); font-family: var(--sans); font-size: 15px; line-height: 1.5; }
  .claim.first { margin-top: 0; padding-top: 0; border-top: 0; }
  .checks { list-style: none; padding: 0; margin: 12px 0 0; display: grid; gap: 4px; font-size: 12px; color: var(--hero-muted); }
  .checks li::before { content: '✓'; color: var(--accent); margin-right: 8px; }
  .rejected .claim { text-decoration: line-through; text-decoration-color: var(--danger-on-dark); text-decoration-thickness: 1px; color: var(--hero-muted); }
  .rejected .checks li::before { content: '✗'; color: var(--danger-on-dark); }
  .rejected .checks li { color: #ffb4a8; }
  .tag { color: var(--accent); }
  .rejected .tag { color: var(--danger-on-dark); }
  .note { font-family: var(--mono); font-size: 11px; color: var(--hero-muted); }
</style>
