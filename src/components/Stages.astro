---
import { getDictionary, type Locale } from '../i18n';
interface Props { locale: Locale }
const s = getDictionary(Astro.props.locale).stages;
---
<section class="band" id="stages">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">{s.eyebrow}</p>
      <h2>{s.h2}</h2>
      <p>{s.lede}</p>
    </div>

    <p class="end start"><strong>{s.inputLabel}</strong> {s.input}</p>

    <ol class="stages">
      {s.items.map((i, n) => (
        <li class="stage">
          <div class="top"><span class="n">{n + 1}</span><span class="tech">{i.name}</span></div>
          <h3>{i.title}</h3>
          <p>{i.p}</p>
          {i.extra && (
            <p class="extra"><span class="badge">{i.extra.badge}</span> {i.extra.text}</p>
          )}
          <span class="writes">{s.writesLabel} · {i.writes}</span>
        </li>
      ))}
    </ol>

    <p class="end finish"><strong>{s.outputLabel}</strong> {s.output}</p>
  </div>
</section>

<style>
  .end { background: var(--surface); border: 1px dashed var(--line); border-radius: 12px; padding: 16px 22px; color: var(--muted); }
  .end strong { color: var(--fg); font-family: var(--mono); font-weight: 500; margin-right: 6px; }
  .start { margin-bottom: 16px; }
  .finish { margin-top: 16px; }
  .stages { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .stage { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 22px; display: grid; gap: 8px; align-content: start; }
  .top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; font-family: var(--mono); font-size: 12px; }
  .n { color: var(--accent-ink); font-weight: 500; }
  .tech { color: var(--muted); }
  h3 { font-size: 21px; font-weight: 600; }
  .stage p { color: var(--muted); font-size: 15px; }
  .extra { border-top: 1px dashed var(--line); padding-top: 10px; margin-top: 4px; font-size: 14px; }
  .badge { display: inline-block; font-family: var(--mono); font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--accent-ink); background: var(--accent-soft); border-radius: 4px; padding: 1px 7px; margin-right: 4px; }
  .writes { margin-top: 4px; font-family: var(--mono); font-size: 12px; color: var(--muted); overflow-wrap: anywhere; }
  @media (max-width: 960px) { .stages { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .stages { grid-template-columns: minmax(0, 1fr); } }
</style>
