---
import { links } from '../config';
import { getDictionary, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const j = getDictionary(locale).join;
const hrefs: Record<string, string> = {
  guide: locale === 'it' ? links.guideIt : links.guide,
  decisions: links.decisions,
  issues: links.issues,
};
---
<section class="band" id="join">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">{j.eyebrow}</p>
      <h2>{j.h2}</h2>
      <p>{j.lede}</p>
    </div>
    <div class="ways">
      {j.items.map((i) => (
        <div class="way">
          <h3>{i.h}</h3>
          <p>{i.p}</p>
          <a class="more-link" href={hrefs[i.href]}>{i.cta}</a>
        </div>
      ))}
    </div>
    <div class="closing">
      <a class="btn btn-primary" href={links.repo}>{j.star}</a>
      <a class="btn btn-ghost" href={links.contributing}>{j.contribute}</a>
    </div>
  </div>
</section>

<style>
  .ways { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .way { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 24px; display: grid; gap: 10px; align-content: start; }
  h3 { font-size: 19px; font-weight: 600; }
  .way p { color: var(--muted); font-size: 15px; }
  .closing { margin-top: 40px; display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  @media (max-width: 960px) { .ways { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .ways { grid-template-columns: minmax(0, 1fr); } }
</style>
