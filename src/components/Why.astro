---
import { getDictionary, type Locale } from '../i18n';
interface Props { locale: Locale }
const w = getDictionary(Astro.props.locale).why;
---
<section class="band" id="why">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">{w.eyebrow}</p>
      <h2>{w.h2}</h2>
      <p>{w.lede}</p>
    </div>
    <ul class="rows">
      {w.items.map((i) => (
        <li>
          <p class="problem">{i.problem}</p>
          <p class="answer">{i.answer}</p>
        </li>
      ))}
    </ul>
    <p class="closing">{w.closing}</p>
  </div>
</section>

<style>
  .rows { list-style: none; padding: 0; display: grid; gap: 16px; }
  li { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); background: var(--surface); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  .problem { padding: 28px; font-size: 19px; line-height: 1.4; font-weight: 600; letter-spacing: -0.01em; border-right: 1px solid var(--line); border-left: 4px solid var(--accent); }
  .answer { padding: 28px; color: var(--muted); }
  .closing { margin-top: 28px; color: var(--muted); max-width: 70ch; }
  @media (max-width: 760px) {
    li { grid-template-columns: minmax(0, 1fr); }
    .problem { border-right: 0; border-bottom: 1px solid var(--line); padding: 22px; }
    .answer { padding: 22px; }
  }
</style>
