---
import { getDictionary, type Locale } from '../i18n';
interface Props { locale: Locale }
const w = getDictionary(Astro.props.locale).why;
---
<section class="band" id="why">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">{w.eyebrow}</p>
      <h2>{w.h2}</h2>
      <p>{w.lede}</p>
    </div>
    <div class="grid">
      {w.items.map((i) => (
        <article>
          <h3>{i.h}</h3>
          <p set:html={i.p} />
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  article { background: var(--surface); padding: 28px; display: grid; gap: 10px; align-content: start; }
  h3 { font-size: 20px; font-weight: 600; }
  article p { color: var(--muted); }
  @media (max-width: 620px) { .grid { grid-template-columns: minmax(0, 1fr); } }
</style>
